{
  "id": "wolf3d",
  "title": "Wolfenstein 3D",
  "kicker": "Wolf4SDL",
  "description": "Escape Castle Wolfenstein with the original presentation and modern browser controls.",
  "loadingTitle": "Starting Wolfenstein 3D…",
  "icon": "/wolf3d.ico",
  "iconPixelated": true,
  "pwa": {
    "shortName": "Wolf3D",
    "themeColor": "#8f1515",
    "backgroundColor": "#000000",
    "icons": [
      { "src": "/wolf3d-192.png", "sizes": "192x192", "type": "image/png" },
      { "src": "/wolf3d-512.png", "sizes": "512x512", "type": "image/png" }
    ]
  },
  "adapter": "/game-adapter.js",
  "displayMode": "4:3",
  "canvasWidth": 960,
  "canvasHeight": 720,
  "pixelated": true,
  "syncBackbuffer": false,
  "pointerLock": true,
  "identity": false,
  "advanced": false,
  "graphics": false,
  "fullscreen": true,
  "controller": {
    "mode": "wasdMouse",
    "label": "WASD + mouse mapping",
    "moveDeadzone": 0.18,
    "lookDeadzone": 0.14,
    "lookSensitivity": 1.15
  },
  "persistence": {
    "root": "/persistent/wolf3d",
    "debounceMs": 750,
    "intervalMs": 5000,
    "requestDurability": true
  },
  "preferencesNamespace": "wolf3d",
  "provisioningText": "Select the eight required Wolfenstein 3D .WL6 files. Matching files are cached in this browser after exact validation.",
  "theme": {
    "accent": "#8f1515",
    "accent-strong": "#f0b34b",
    "border": "#612020",
    "panel": "rgb(15 9 8 / 96%)",
    "field": "#170c0b"
  }
}
